<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Sesi 1-on-1 AI &amp; Teknologi bersama Derry Derajat</title>
<meta name="description" content="Konsultasi dan mentoring privat bersama Derry Derajat: belajar AI sesuai kebutuhanmu, atau bedah masalah teknologi dan dapatkan rekomendasi solusinya.">
<meta name="theme-color" content="#EEF2FA">
<link rel="canonical" href="https://1on1.derry.my.id/">
<meta property="og:type" content="website">
<meta property="og:url" content="https://1on1.derry.my.id/">
<meta property="og:locale" content="id_ID">
<meta property="og:title" content="Sesi 1-on-1 AI &amp; Teknologi bersama Derry Derajat">
<meta property="og:description" content="Mentoring AI personal atau konsultasi AI &amp; IT. Bahas kebutuhanmu langsung, satu lawan satu.">
<meta property="og:image" content="https://1on1.derry.my.id/derry.webp">
<meta name="robots" content="index,follow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ground:#EEF2FA;
  --card:#FFFFFF;
  --ink:#101A3D;
  --ink-soft:#4B5578;
  --blue:#2F45E8;
  --blue-dark:#2236C4;
  --mint:#C9F2DE;
  --sun:#FFD25A;
  --line:#D3DBEE;
  --err:#C0262D;
  --radius:14px;
  --gutter:20px;
  --font:"Plus Jakarta Sans","Segoe UI",system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--ground);color:var(--ink);font-family:var(--font);font-size:16px;line-height:1.6;padding-bottom:env(safe-area-inset-bottom)}
img,svg{display:block;max-width:100%}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:4px}
.wrap{width:100%;max-width:1060px;margin:0 auto;padding:0 var(--gutter)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
h1,h2,h3{margin:0;line-height:1.12;letter-spacing:-.025em}

/* top bar */
.bar{position:sticky;top:0;z-index:20;background:rgba(238,242,250,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top)}
.bar .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:60px}
.bar-info{display:flex;flex-direction:column;line-height:1.25;min-width:0}
.bar-info small{font-size:12px;color:var(--ink-soft)}
.bar-name{font-weight:800;font-size:17px}

/* buttons */
.btn{appearance:none;border:0;background:var(--blue);color:#fff;font:700 16px/1 var(--font);min-height:50px;padding:0 24px;border-radius:999px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;transition:background .15s ease}
.btn:hover{background:var(--blue-dark)}
.btn[disabled]{opacity:.6;cursor:wait}
.btn-sm{min-height:44px;padding:0 20px;font-size:15px}
.btn-block{width:100%}
.btn-ghost{background:transparent;color:var(--blue);border:2px solid var(--blue)}
.btn-ghost:hover{background:var(--blue);color:#fff}

/* hero */
.hero{padding:44px 0 56px}
.hero .wrap{display:grid;gap:36px}
h1{font-size:clamp(33px,8.2vw,56px);font-weight:800;max-width:17ch}
.lead{font-size:18px;color:var(--ink-soft);margin:18px 0 0;max-width:42ch}
.hero-cta{margin-top:26px;display:flex;flex-wrap:wrap;gap:12px}
.hero-cta .btn{min-width:210px}

.who{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:14px;max-width:380px}
.who img{width:100%;aspect-ratio:1/1;object-fit:cover;object-position:50% 25%;border-radius:14px}
.who-cap{padding:14px 6px 4px}
.who-cap b{display:block;font-size:19px;font-weight:800}
.who-cap span{display:block;font-size:14px;color:var(--ink-soft);line-height:1.45;margin-top:2px}

/* price */
.price{background:var(--ink);color:#fff;border-radius:22px;padding:26px 24px 24px}
.price-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px}
.tag{font-weight:800;font-size:13px;background:var(--sun);color:var(--ink);padding:6px 12px;border-radius:999px}
.save{font-weight:700;font-size:14px;color:var(--mint)}
.old{font-size:17px;opacity:.65;text-decoration:line-through;text-decoration-thickness:2px}
.now{font-weight:800;font-size:clamp(46px,13vw,62px);line-height:1;letter-spacing:-.035em;margin:4px 0 0;font-variant-numeric:tabular-nums}
.now span{font-size:.4em;font-weight:700;margin-right:6px;vertical-align:.7em;opacity:.8}
.price ul{list-style:none;margin:20px 0 0;padding:16px 0 0;border-top:1px solid rgba(255,255,255,.18);display:grid;gap:8px;font-size:15px}
.price li{padding-left:24px;position:relative}
.price li::before{content:"";position:absolute;left:2px;top:.5em;width:10px;height:6px;border-left:2.5px solid var(--mint);border-bottom:2.5px solid var(--mint);transform:rotate(-45deg)}
.clock{margin:22px 0;padding-top:18px;border-top:1px solid rgba(255,255,255,.18)}
.clock p{margin:0 0 10px;font-size:14px;opacity:.75}
.digits{display:flex;gap:8px}
.digit{flex:1;background:rgba(255,255,255,.09);border-radius:12px;padding:10px 4px 8px;text-align:center}
.digit b{display:block;font-size:30px;line-height:1;font-weight:800;font-variant-numeric:tabular-nums}
.digit i{display:block;font-style:normal;font-size:12px;opacity:.65;margin-top:5px}
.price .btn{background:var(--sun);color:var(--ink)}
.price .btn:hover{background:#FFC633}
.fine{font-size:13px;color:var(--ink-soft);margin:12px 0 0;text-align:center}

/* sections */
section{padding:56px 0}
.alt{background:var(--card)}
h2{font-size:clamp(27px,6.4vw,40px);font-weight:800;max-width:22ch}
.sec-sub{color:var(--ink-soft);margin:14px 0 0;max-width:52ch}

/* profil konsultan */
.profile{display:grid;gap:30px;margin-top:30px}
.profile p{margin:0 0 14px;color:var(--ink-soft);max-width:58ch}
.profile p b{color:var(--ink)}
.pill-list{list-style:none;margin:6px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
.pill-list li{background:var(--ground);border:1px solid var(--line);border-radius:999px;padding:8px 16px;font-size:14px;font-weight:600}
.profile-photo img{width:100%;max-width:340px;aspect-ratio:1/1;object-fit:cover;object-position:50% 25%;border-radius:22px;border:1px solid var(--line)}

/* pilihan layanan */
.services{margin-top:30px;display:grid;gap:18px}
.svc{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:26px 24px;display:flex;flex-direction:column}
.alt .svc{background:var(--ground)}
.svc-no{font-weight:800;font-size:13px;color:var(--blue);letter-spacing:.08em;text-transform:uppercase}
.svc h3{font-size:24px;font-weight:800;margin:8px 0 8px}
.svc>p{margin:0;color:var(--ink-soft)}
.svc h4{margin:20px 0 8px;font-size:14px;font-weight:700}
.svc ul{margin:0;padding-left:20px;color:var(--ink-soft);display:grid;gap:5px;font-size:15px}
.svc .out{margin:18px 0 22px;padding:12px 14px;background:var(--mint);border-radius:12px;font-size:14px;color:var(--ink)}
.svc .btn{margin-top:auto}

/* daftar poin */
.grid2{margin-top:30px;display:grid;gap:18px}
.box{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:24px}
.alt .box{background:var(--ground)}
.box h3{font-size:20px;font-weight:800;margin-bottom:12px}
.box ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.box li{position:relative;padding-left:28px;color:var(--ink-soft)}
.box li b{color:var(--ink)}
.box.yes li::before{content:"";position:absolute;left:3px;top:.5em;width:12px;height:7px;border-left:3px solid var(--blue);border-bottom:3px solid var(--blue);transform:rotate(-45deg)}
.box.no li::before{content:"\00d7";position:absolute;left:3px;top:-.15em;font-size:22px;line-height:1.4;font-weight:700;color:var(--err)}

/* alur: timeline vertikal */
.steps{list-style:none;margin:32px 0 0;padding:0;counter-reset:s;max-width:620px}
.steps li{counter-increment:s;position:relative;padding:0 0 28px 62px}
.steps li:last-child{padding-bottom:0}
.steps li::before{content:counter(s);position:absolute;left:0;top:0;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:17px;background:var(--ground);color:var(--blue);border:2px solid var(--blue)}
.steps li:last-child::before{background:var(--blue);color:#fff}
.steps li::after{content:"";position:absolute;left:20px;top:48px;bottom:6px;width:2px;background:var(--line)}
.steps li:last-child::after{display:none}
.steps h3{font-size:19px;font-weight:700;margin:6px 0 2px}
.steps p{margin:0;color:var(--ink-soft)}

/* cocok untuk */
.fit{margin:26px 0 0;padding:0;list-style:none;display:grid;gap:12px;max-width:640px}
.fit li{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 18px;color:var(--ink-soft)}
.fit li b{color:var(--ink)}

/* faq */
.faq{margin-top:28px;display:grid;gap:10px;max-width:720px}
details{background:var(--card);border:1px solid var(--line);border-radius:16px}
summary{cursor:pointer;list-style:none;padding:16px 52px 16px 18px;font-weight:700;position:relative;min-height:52px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";position:absolute;right:18px;top:50%;transform:translateY(-50%);font-size:24px;font-weight:600;color:var(--blue)}
details[open] summary::after{content:"\2212"}
details p{margin:0;padding:0 18px 16px;color:var(--ink-soft)}

/* form */
.formcard{margin-top:28px;background:var(--ground);border-radius:22px;padding:24px}
.field{margin-bottom:18px}
label,.lbl{display:block;font-weight:700;font-size:15px;margin-bottom:7px}
.hint{display:block;font-size:13px;color:var(--ink-soft);margin-top:6px;font-weight:400}
input[type=text],input[type=tel],textarea{width:100%;font:400 16px/1.4 var(--font);color:var(--ink);background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:12px 14px;min-height:50px}
input[type=text]:focus,input[type=tel]:focus,textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(47,69,232,.2)}
textarea{min-height:130px;resize:vertical}
input::placeholder,textarea::placeholder{color:#8991AD}
.phone{display:flex;align-items:stretch}
.phone .cc{display:flex;align-items:center;padding:0 14px;font-weight:700;background:#fff;border:1.5px solid var(--line);border-right:0;border-radius:12px 0 0 12px;color:var(--ink-soft)}
.phone input{border-radius:0 12px 12px 0}
.opts{display:grid;gap:8px;border:0;padding:0;margin:0}
.opts legend{font-weight:700;font-size:15px;margin-bottom:7px;padding:0}
.opt{display:flex;align-items:center;gap:10px;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:0 14px;min-height:50px;font-weight:500;font-size:15px;margin:0;cursor:pointer}
.opt input{accent-color:var(--blue);width:18px;height:18px;margin:0;flex:none}
.opt:has(input:checked){border-color:var(--blue);background:#F4F6FF}
[aria-invalid=true]{border-color:var(--err)!important;background:#FFF4F4!important}
.err{display:none;color:var(--err);font-size:14px;font-weight:500;margin-top:6px}
[aria-invalid=true] ~ .err,.phone[data-invalid] ~ .err{display:block}
.trap{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}

/* dialog */
dialog{width:min(440px,calc(100vw - 24px));max-height:calc(100dvh - 24px);overflow:auto;border:0;border-radius:24px;padding:0;background:var(--card);color:var(--ink);box-shadow:0 24px 60px rgba(16,26,61,.3)}
dialog::backdrop{background:rgba(16,26,61,.55)}
.dlg-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:22px 22px 0}
.dlg-head h2{font-size:26px;max-width:none}
.dlg-body{padding:16px 22px 24px}
.x{appearance:none;border:0;background:var(--ground);color:var(--ink);width:44px;height:44px;border-radius:50%;cursor:pointer;font-size:22px;line-height:1;flex:none}
.x:hover{background:var(--line)}

footer{padding:32px 0 44px;font-size:14px;color:var(--ink-soft)}
footer .name{margin:0 0 14px}
.social{display:flex;flex-wrap:wrap;gap:22px;margin:0}
.social a{display:inline-flex;align-items:center;gap:8px;color:inherit;text-decoration:none;font-weight:600}
.social a:hover{color:var(--blue)}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;padding:12px 18px;border-radius:999px;font-weight:500;font-size:15px;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:50;max-width:calc(100vw - 32px);text-align:center}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media (min-width:860px){
  :root{--gutter:32px}
  .hero{padding:72px 0 88px}
  .hero .wrap{grid-template-columns:1.25fr .75fr;gap:64px;align-items:center}
  section{padding:88px 0}
  .profile{grid-template-columns:.8fr 1.2fr;gap:56px;align-items:start}
  .services,.grid2{grid-template-columns:1fr 1fr}
  .split{display:grid;grid-template-columns:.9fr 1.1fr;gap:64px;align-items:start}
  .split .price{margin-top:28px}
  .formcard{margin-top:0}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .btn,.toast{transition:none}
}
</style>
</head>
<body>

<header class="bar">
  <div class="wrap">
    <div class="bar-info">
      <span class="bar-name">Derry Derajat</span>
      <small>AI &amp; Technology Consultant</small>
    </div>
    <button class="btn btn-sm" type="button" data-open-dialog>Booking</button>
  </div>
</header>

<main>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="judul">
    <div class="wrap">
      <div>
        <h1 id="judul">Jangan sekadar memakai teknologi. Buat ia bekerja untukmu.</h1>
        <p class="lead">Konsultasi privat satu lawan satu untuk memahami, memilih, dan menerapkan AI serta solusi teknologi berdasarkan kebutuhanmu yang nyata.</p>
        <div class="hero-cta">
          <button class="btn" type="button" data-open-dialog>Konsultasikan kebutuhanmu</button>
          <a class="btn btn-ghost" href="#layanan">Lihat pilihan sesi</a>
        </div>
      </div>
      <figure class="who" style="margin:0">
        <img src="derry.webp" width="800" height="800" alt="Foto Derry Derajat, konsultan sesi 1-on-1" fetchpriority="high">
        <figcaption class="who-cap">
          <b>Derry Derajat</b>
          <span>QA Engineer &amp; Founder Recehin. Membangun tools keuangan pribadi berbasis AI.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Meet your consultant -->
  <section class="alt" id="konsultan" aria-labelledby="tentang">
    <div class="wrap">
      <h2 id="tentang">Kenalan dulu dengan konsultanmu</h2>
      <div class="profile">
        <div class="profile-photo">
          <img src="derry.webp" width="800" height="800" alt="Derry Derajat" loading="lazy">
        </div>
        <div>
          <p>Saya <b>Derry Derajat</b>. Saya bekerja di bidang IT sebagai <b>QA Engineer</b>, jadi kebiasaan saya adalah menguji dan menilai apakah sebuah sistem benar-benar berjalan seperti yang dijanjikan.</p>
          <p>Saya juga <b>founder Recehin</b>, yang sedang membangun tools keuangan pribadi berbasis AI, dan membuka <b>jasa otomasi</b>. Karena itu fokus saya bukan memperkenalkan tools satu per satu, melainkan membantu kamu menentukan kapan teknologi perlu dipakai, bagaimana menerapkannya, dan apa dampaknya untuk kebutuhanmu.</p>
          <p style="margin-bottom:10px"><b>Area yang bisa kita bahas:</b></p>
          <ul class="pill-list">
            <li>AI untuk kerja &amp; bisnis</li>
            <li>AI Agent &amp; otomasi workflow</li>
            <li>Pemilihan solusi teknologi</li>
            <li>Kualitas software &amp; evaluasi sistem</li>
            <li>Produk berbasis AI</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Pilihan layanan -->
  <section id="layanan" aria-labelledby="pilih">
    <div class="wrap">
      <h2 id="pilih">Dua cara bekerja bersama</h2>
      <p class="sec-sub">Keduanya sesi privat, tapi tujuannya berbeda. Pilih yang paling dekat dengan kebutuhanmu, atau pilih "belum tahu" dan kita tentukan bersama.</p>

      <div class="services">
        <article class="svc">
          <span class="svc-no">Layanan 01</span>
          <h3>AI Personal Mentoring</h3>
          <p>Belajar, mencoba, dan mempraktikkan AI langsung dari kasusmu sendiri, dengan didampingi.</p>
          <h4>Contoh yang bisa dibahas</h4>
          <ul>
            <li>ChatGPT dan teknik prompting</li>
            <li>AI Agent dan otomasi dasar</li>
            <li>AI untuk produktivitas kerja</li>
            <li>AI untuk bisnis kecil dan pembuatan konten</li>
          </ul>
          <p class="out"><b>Hasilnya:</b> kamu paham dan bisa mempraktikkannya sendiri setelah sesi.</p>
          <button class="btn btn-ghost" type="button" data-open-dialog data-service="AI Personal Mentoring">Pilih Mentoring</button>
        </article>

        <article class="svc">
          <span class="svc-no">Layanan 02</span>
          <h3>AI &amp; IT Consulting</h3>
          <p>Membedah masalah, menimbang pilihan, dan mendapatkan rekomendasi solusi teknologi yang tepat untuk individu, profesional, atau bisnis.</p>
          <h4>Contoh yang bisa dibahas</h4>
          <ul>
            <li>Analisis kebutuhan dan proses kerja</li>
            <li>Rekomendasi tools atau solusi teknologi</li>
            <li>Strategi adopsi AI dan otomasi</li>
            <li>Evaluasi rancangan sistem</li>
          </ul>
          <p class="out"><b>Hasilnya:</b> analisis, rekomendasi, dan arah langkah selanjutnya yang jelas.</p>
          <button class="btn btn-ghost" type="button" data-open-dialog data-service="AI & IT Consulting">Pilih Consulting</button>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Yang didapat / tidak termasuk -->
  <section class="alt" aria-labelledby="dapat">
    <div class="wrap">
      <h2 id="dapat">Apa yang kamu bawa pulang</h2>
      <p class="sec-sub">Supaya tidak ada salah ekspektasi, ini yang termasuk dan yang tidak termasuk dalam satu sesi.</p>
      <div class="grid2">
        <div class="box yes">
          <h3>Termasuk dalam sesi</h3>
          <ul>
            <li><b>Satu sesi privat</b> yang membahas kebutuhanmu, bukan materi umum.</li>
            <li><b>Satu kasus dibedah bersama</b>, dari situasi nyata yang kamu hadapi.</li>
            <li><b>Rekomendasi tools atau pendekatan</b> yang sesuai konteksmu.</li>
            <li><b>Langkah lanjut yang jelas</b> untuk dikerjakan setelah sesi.</li>
          </ul>
        </div>
        <div class="box no">
          <h3>Belum termasuk</h3>
          <ul>
            <li>Membangun aplikasi, AI Agent, atau sistem bisnis secara utuh.</li>
            <li>Menjamin satu sesi menyelesaikan semua masalah.</li>
            <li>Pekerjaan implementasi. Kalau dibutuhkan, itu proyek terpisah yang kita bahas dan sepakati sendiri.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Cocok untuk siapa -->
  <section aria-labelledby="cocok">
    <div class="wrap">
      <h2 id="cocok">Sesi ini cocok kalau kamu</h2>
      <ul class="fit">
        <li><b>Baru mulai dengan AI</b> dan bingung harus mulai dari mana.</li>
        <li><b>Sudah memakai AI</b> tapi merasa hasilnya belum maksimal untuk pekerjaanmu.</li>
        <li><b>Punya masalah atau ide</b> dan ingin tahu teknologi apa yang cocok sebelum mengeluarkan biaya.</li>
        <li><b>Menjalankan usaha</b> dan ingin tahu bagian mana yang bisa dirapikan atau diotomasi.</li>
      </ul>
    </div>
  </section>

  <!-- 6. Alur pendaftaran -->
  <section class="alt" aria-labelledby="alur">
    <div class="wrap">
      <h2 id="alur">Alur pendaftaran sesi 1-on-1</h2>
      <ol class="steps">
        <li>
          <h3>Isi data diri</h3>
          <p>Pilih jenis sesi dan isi data singkat, agar saya bisa menghubungimu.</p>
        </li>
        <li>
          <h3>Lanjut di WhatsApp</h3>
          <p>Ceritakan kebutuhanmu. Saya bantu pastikan jenis sesi yang paling pas.</p>
        </li>
        <li>
          <h3>Booking jadwal</h3>
          <p>Waktu sesi disepakati lewat chat, menyesuaikan jadwalmu.</p>
        </li>
        <li>
          <h3>Pembayaran</h3>
          <p>Lakukan pembayaran untuk mengunci jadwal.</p>
        </li>
        <li>
          <h3>Sesi 1-on-1 dimulai</h3>
          <p>Kita bahas kasusmu, dari masalah sampai rekomendasi dan langkah lanjut.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 7. Harga & booking -->
  <section id="form" aria-labelledby="formjudul">
    <div class="wrap split">
      <div>
        <h2 id="formjudul">Investasi &amp; booking</h2>
        <p class="sec-sub">Ceritakan saja kebutuhanmu. Tidak perlu rapi atau lengkap, nanti kita rapikan bareng di sesi.</p>

        <aside class="price" aria-label="Harga sesi">
          <div class="price-top">
            <span class="tag">Harga sale</span>
            <span class="save">Hemat Rp300.000</span>
          </div>
          <div class="old"><span class="sr">Harga normal </span>Rp699.000</div>
          <div class="now"><span>Rp</span>399.000</div>
          <ul>
            <li>Satu sesi privat 1-on-1</li>
            <li>Berlaku untuk Mentoring maupun Consulting</li>
          </ul>
          <div class="clock" role="timer" aria-label="Sisa waktu harga sale">
            <p>Harga sale berlaku sampai hitungan mundur habis:</p>
            <div class="digits" aria-hidden="true">
              <div class="digit"><b data-h>02</b><i>jam</i></div>
              <div class="digit"><b data-m>44</b><i>menit</i></div>
              <div class="digit"><b data-s>00</b><i>detik</i></div>
            </div>
          </div>
          <button class="btn btn-block" type="button" data-open-dialog>Booking sekarang</button>
        </aside>
      </div>

      <form class="formcard" id="leadForm" novalidate>
        <fieldset class="opts field">
          <legend>Jenis sesi</legend>
          <label class="opt"><input type="radio" name="layanan" value="AI Personal Mentoring"> AI Personal Mentoring</label>
          <label class="opt"><input type="radio" name="layanan" value="AI & IT Consulting"> AI &amp; IT Consulting</label>
          <label class="opt"><input type="radio" name="layanan" value="Belum tahu" checked> Belum tahu, mau diskusi dulu</label>
        </fieldset>
        <div class="field">
          <label for="f-nama">Nama</label>
          <input id="f-nama" name="nama" type="text" autocomplete="name" maxlength="80" placeholder="Nama panggilanmu" aria-describedby="e-nama">
          <p class="err" id="e-nama">Nama belum diisi.</p>
        </div>
        <div class="field">
          <label for="f-hp">Nomor HP (WhatsApp)</label>
          <div class="phone" id="f-hp-wrap">
            <span class="cc" aria-hidden="true">+62</span>
            <input id="f-hp" name="hp" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder="812 3456 7890" aria-describedby="h-hp e-hp">
          </div>
          <span class="hint" id="h-hp">Tulis tanpa angka 0 di depan. Contoh: 812 3456 7890</span>
          <p class="err" id="e-hp">Nomor tidak valid. Isi 8 sampai 12 angka setelah +62.</p>
        </div>
        <div class="field">
          <label for="f-need">Kebutuhanmu apa?</label>
          <textarea id="f-need" name="kebutuhan" maxlength="800" placeholder="Misalnya: apa yang sedang kamu hadapi, atau hasil apa yang kamu mau." aria-describedby="e-need"></textarea>
          <p class="err" id="e-need">Ceritakan sedikit kebutuhanmu, satu dua kalimat sudah cukup.</p>
        </div>
        <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button class="btn btn-block" type="submit">Kirim dan lanjut ke WhatsApp</button>
        <p class="fine">Datamu hanya dipakai untuk menghubungimu terkait sesi.</p>
      </form>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="alt" aria-labelledby="faq">
    <div class="wrap">
      <h2 id="faq">Pertanyaan yang sering muncul</h2>
      <div class="faq">
        <details>
          <summary>Apa bedanya Mentoring dan Consulting?</summary>
          <p>Mentoring untuk belajar dan berlatih: kamu dipandu sampai bisa mempraktikkannya sendiri. Consulting untuk membedah masalah: kamu mendapat analisis, rekomendasi solusi, dan arah langkah berikutnya. Kalau masih ragu, pilih "belum tahu" dan kita tentukan bersama di WhatsApp.</p>
        </details>
        <details>
          <summary>Saya pemula, apakah cocok?</summary>
          <p>Cocok. Sesi dimulai dari situasi dan tingkat pemahamanmu, jadi tidak perlu paham teknis lebih dulu.</p>
        </details>
        <details>
          <summary>Apakah Anda akan membangunkan aplikasi atau AI Agent saya?</summary>
          <p>Sesi ini untuk konsultasi dan pendampingan, bukan pekerjaan implementasi. Kalau dari hasil sesi kamu butuh sesuatu dibangun, itu dibahas sebagai proyek terpisah dengan ruang lingkup dan kesepakatan sendiri.</p>
        </details>
        <details>
          <summary>Kapan jadwal sesinya?</summary>
          <p>Waktunya dicocokkan lewat chat WhatsApp, jadi tidak terikat jam yang sudah ditentukan.</p>
        </details>
        <details>
          <summary>Kapan saya membayar?</summary>
          <p>Setelah jadwal disepakati di WhatsApp. Pembayaran dilakukan untuk mengunci jadwal sesimu.</p>
        </details>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <p class="name">Derry Derajat &middot; AI &amp; Technology Consultant &middot; Cilegon, Banten</p>
    <p class="social"><a href="https://www.instagram.com/derryyyderajat" target="_blank" rel="noopener" aria-label="Instagram @derryyyderajat"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg><span>@derryyyderajat</span></a><a href="https://www.threads.com/@derryyyderajat" target="_blank" rel="noopener" aria-label="Threads @derryyyderajat"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 9.5C16.8 6.6 14.8 5 12 5 8.5 5 6.5 7.6 6.5 12s2 7 5.5 7c2.9 0 4.8-1.5 4.8-3.7 0-2.3-1.9-3.3-4.3-3.3-1.7 0-2.8.7-2.8 1.8 0 1 .8 1.6 2 1.6 1.9 0 3-1.2 3-3.9"/></svg><span>@derryyyderajat</span></a></p>
  </div>
</footer>

<dialog id="dlg" aria-labelledby="dlg-judul">
  <div class="dlg-head">
    <h2 id="dlg-judul">Isi Data Diri</h2>
    <button class="x" type="button" data-close aria-label="Tutup">&times;</button>
  </div>
  <form class="dlg-body" id="quickForm" novalidate>
    <fieldset class="opts field">
      <legend>Jenis sesi</legend>
      <label class="opt"><input type="radio" name="layanan" value="AI Personal Mentoring"> AI Personal Mentoring</label>
      <label class="opt"><input type="radio" name="layanan" value="AI & IT Consulting"> AI &amp; IT Consulting</label>
      <label class="opt"><input type="radio" name="layanan" value="Belum tahu" checked> Belum tahu, mau diskusi dulu</label>
    </fieldset>
    <div class="field">
      <label for="q-nama">Nama</label>
      <input id="q-nama" name="nama" type="text" autocomplete="name" maxlength="80" placeholder="Nama panggilanmu" aria-describedby="qe-nama">
      <p class="err" id="qe-nama">Nama belum diisi.</p>
    </div>
    <div class="field">
      <label for="q-hp">Nomor HP (WhatsApp)</label>
      <div class="phone" id="q-hp-wrap">
        <span class="cc" aria-hidden="true">+62</span>
        <input id="q-hp" name="hp" type="tel" inputmode="numeric" autocomplete="tel-national" maxlength="14" placeholder="812 3456 7890" aria-describedby="qh-hp qe-hp">
      </div>
      <span class="hint" id="qh-hp">Tulis tanpa angka 0 di depan.</span>
      <p class="err" id="qe-hp">Nomor tidak valid. Isi 8 sampai 12 angka setelah +62.</p>
    </div>
    <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button class="btn btn-block" type="submit">Lanjut ke WhatsApp</button>
  </form>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function(){
  'use strict';

  /* ====== PENGATURAN — ubah di sini ====== */
  var CONFIG = {
    waNumber: '6289677816465',
    waText:   'Halo, saya ingin mendaftar di sesi 1 on 1',
    // URL Web App Google Apps Script (lihat apps-script.gs). Kosong = data belum terkirim ke Sheet.
    endpoint: '',
    saleSeconds: 2 * 3600 + 44 * 60,   // 2 jam 44 menit
    price: 399000,
    storeKey: 'sale_end_ts'
  };

  /* ====== Hitungan mundur (cookie + localStorage) ====== */
  function getCookie(k){
    var m = document.cookie.match(new RegExp('(?:^|; )' + k + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : null;
  }
  function setCookie(k, v, seconds){
    try { document.cookie = k + '=' + encodeURIComponent(v) + '; max-age=' + seconds + '; path=/; SameSite=Lax'; } catch(e){}
  }
  function lsGet(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
  function lsSet(k, v){ try { localStorage.setItem(k, v); } catch(e){} }

  function resolveEnd(){
    var now = Date.now();
    var saved = Number(getCookie(CONFIG.storeKey) || lsGet(CONFIG.storeKey));
    // masih berjalan dan tidak lebih jauh dari durasi penuh (cegah nilai rusak)
    if (saved && saved > now && saved - now <= CONFIG.saleSeconds * 1000 + 2000) return saved;
    var end = now + CONFIG.saleSeconds * 1000;
    setCookie(CONFIG.storeKey, end, CONFIG.saleSeconds);
    lsSet(CONFIG.storeKey, end);
    return end;
  }

  var endTs = resolveEnd();
  var elH = document.querySelector('[data-h]');
  var elM = document.querySelector('[data-m]');
  var elS = document.querySelector('[data-s]');
  function pad(n){ return n < 10 ? '0' + n : '' + n; }
  function tick(){
    var left = Math.max(0, Math.round((endTs - Date.now()) / 1000));
    var h = Math.floor(left / 3600), m = Math.floor((left % 3600) / 60), s = left % 60;
    elH.textContent = pad(h); elM.textContent = pad(m); elS.textContent = pad(s);
    if (left === 0) clearInterval(timer);
  }
  var timer = setInterval(tick, 1000);
  tick();
  document.addEventListener('visibilitychange', function(){ if (!document.hidden) tick(); });

  /* ====== Helper form ====== */
  function digitsOnly(v){
    var d = String(v || '').replace(/\D/g, '');
    if (d.indexOf('62') === 0) d = d.slice(2);
    if (d.indexOf('0') === 0) d = d.replace(/^0+/, '');
    return d;
  }
  function setInvalid(input, bad, wrap){
    input.setAttribute('aria-invalid', bad ? 'true' : 'false');
    if (wrap){ if (bad) wrap.setAttribute('data-invalid',''); else wrap.removeAttribute('data-invalid'); }
  }
  function toast(msg){
    var t = document.getElementById('toast');
    t.textContent = msg; t.classList.add('show');
    clearTimeout(toast._t); toast._t = setTimeout(function(){ t.classList.remove('show'); }, 3800);
  }

  // Jenis sesi dicatat di kolom "Sumber" supaya skema Google Sheet tidak berubah.
  function sendLead(data){
    var payload = {
      nama: data.nama,
      hp: '+62' + data.hp,
      kebutuhan: data.kebutuhan || '',
      sumber: data.sumber + ' | ' + data.layanan,
      harga: CONFIG.price,
      waktuKlien: new Date().toISOString(),
      halaman: location.href
    };
    if (!CONFIG.endpoint){ console.warn('[lead] endpoint belum diisi, data tidak dikirim ke Sheet:', payload); return; }
    try {
      fetch(CONFIG.endpoint, {
        method: 'POST', mode: 'no-cors', keepalive: true,
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload)
      }).catch(function(){});
    } catch(e){}
  }

  function openWA(nama, layanan){
    var text = CONFIG.waText + '. Nama saya ' + nama + '.';
    if (layanan && layanan !== 'Belum tahu') text += ' Jenis sesi: ' + layanan + '.';
    else text += ' Saya belum tahu jenis sesi yang cocok, mau diskusi dulu.';
    var url = 'https://wa.me/' + CONFIG.waNumber + '?text=' + encodeURIComponent(text);
    var w = window.open(url, '_blank', 'noopener');
    if (!w) location.href = url;
  }

  function bindForm(form, opts){
    var nama = form.querySelector('[name=nama]');
    var hp = form.querySelector('[name=hp]');
    var need = form.querySelector('[name=kebutuhan]');
    var wrap = form.querySelector('.phone');
    var trap = form.querySelector('[name=website]');
    var btn = form.querySelector('button[type=submit]');

    hp.addEventListener('input', function(){
      var d = digitsOnly(hp.value).slice(0, 12);
      hp.value = d.replace(/(\d{3})(?=\d)/g, '$1 ').trim();
    });
    [nama, hp, need].forEach(function(el){
      if (!el) return;
      el.addEventListener('input', function(){ setInvalid(el, false, el === hp ? wrap : null); });
    });

    form.addEventListener('submit', function(ev){
      ev.preventDefault();
      var n = nama.value.trim();
      var d = digitsOnly(hp.value);
      var k = need ? need.value.trim() : '';
      var pick = form.querySelector('[name=layanan]:checked');
      var layanan = pick ? pick.value : 'Belum tahu';
      var bad = null;

      setInvalid(nama, !n);            if (!n) bad = bad || nama;
      var hpBad = d.length < 8 || d.length > 12;
      setInvalid(hp, hpBad, wrap);     if (hpBad) bad = bad || hp;
      if (need){ setInvalid(need, !k); if (!k) bad = bad || need; }
      if (bad){ bad.focus(); return; }

      if (trap.value){ return; } // bot

      btn.disabled = true;
      sendLead({ nama: n, hp: d, kebutuhan: k, sumber: opts.sumber, layanan: layanan });
      openWA(n, layanan);
      toast('Datamu tercatat. Kalau WhatsApp tidak terbuka, cek pop-up browser.');
      if (opts.onDone) opts.onDone();
      form.reset();
      setTimeout(function(){ btn.disabled = false; }, 4000);
    });
  }

  var dlg = document.getElementById('dlg');
  var quick = document.getElementById('quickForm');
  bindForm(document.getElementById('leadForm'), { sumber: 'Form bawah (dengan kebutuhan)' });
  bindForm(quick, { sumber: 'Booking cepat', onDone: function(){ dlg.close(); } });

  /* ====== Dialog ====== */
  document.querySelectorAll('[data-open-dialog]').forEach(function(b){
    b.addEventListener('click', function(){
      var svc = b.getAttribute('data-service');
      if (svc){
        quick.querySelectorAll('[name=layanan]').forEach(function(r){ r.checked = (r.value === svc); });
      }
      if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open','');
      setTimeout(function(){ document.getElementById('q-nama').focus(); }, 30);
    });
  });
  dlg.querySelector('[data-close]').addEventListener('click', function(){ dlg.close(); });
  dlg.addEventListener('click', function(e){
    var r = dlg.getBoundingClientRect();
    if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dlg.close();
  });
})();
</script>
</body>
</html>
